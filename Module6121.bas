        LogLine "JPG OK: " & imagePath & " size=" & CStr(fso.GetFile(imagePath).Size) & " bytes"
        SaveViewAsImage = True
    Else
        LogLine "WARNING: JPG was not created: " & imagePath
    End If

    Exit Function

ErrHandler:
